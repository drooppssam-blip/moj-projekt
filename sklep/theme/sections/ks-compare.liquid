{{ 'ks-landing.css' | asset_url | stylesheet_tag }}
<div class="ks ks-sec ks-sec--alt">
  <div class="ks-wrap">
    <div class="ks-center">
      <span class="ks-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ks-table-scroll">
      <table class="ks-table">
        <thead><tr><th></th><th class="ks-us">{{ section.settings.col1 }}</th><th>{{ section.settings.col2 }}</th><th>{{ section.settings.col3 }}</th><th>{{ section.settings.col4 }}</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.label }}</td>
              {%- assign vals = block.settings.values | split: '|' -%}
              {%- for val in vals -%}
                {%- assign t = val | strip -%}
                <td{% if forloop.first %} class="ks-us"{% endif %}>
                  {%- case t -%}{%- when 'tak' -%}<span class="ks-yes">✓</span>{%- when 'nie' -%}<span class="ks-no">✕</span>{%- else -%}{{ t }}{%- endcase -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "KS Porównanie",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nad nagłówkiem", "default": "Porównanie" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "A czym bawisz się z kotem dziś?" },
    { "type": "text", "id": "col1", "label": "Kolumna 1", "default": "Sparing Kot" },
    { "type": "text", "id": "col2", "label": "Kolumna 2", "default": "Gołe ręce" },
    { "type": "text", "id": "col3", "label": "Kolumna 3", "default": "Gruba rękawica" },
    { "type": "text", "id": "col4", "label": "Kolumna 4", "default": "Wędka z piórkiem" }
  ],
  "blocks": [
    { "type": "row", "name": "Wiersz", "settings": [
      { "type": "text", "id": "label", "label": "Cecha", "default": "Cecha" },
      { "type": "text", "id": "values", "label": "Wartości: tak lub nie, oddziel |", "default": "tak|nie|nie|tak" }
    ] }
  ],
  "presets": [{ "name": "KS Porównanie" }]
}
{% endschema %}
