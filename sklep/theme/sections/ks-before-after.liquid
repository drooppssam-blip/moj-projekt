{{ 'ks-landing.css' | asset_url | stylesheet_tag }}
<div class="ks ks-sec">
  <div class="ks-wrap">
    <div class="ks-center">
      <span class="ks-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ks-ba">
      <figure>
        {%- if section.settings.before != blank -%}{{ section.settings.before | image_url: width: 900 | image_tag: alt: section.settings.before_label, loading: 'lazy', sizes: '46vw' }}{%- endif -%}
        <figcaption>{{ section.settings.before_label }}</figcaption>
      </figure>
      <figure>
        {%- if section.settings.after != blank -%}{{ section.settings.after | image_url: width: 900 | image_tag: alt: section.settings.after_label, loading: 'lazy', sizes: '46vw' }}{%- endif -%}
        <figcaption>{{ section.settings.after_label }}</figcaption>
      </figure>
    </div>
    <div class="ks-ba__caps">
      <p>{{ section.settings.before_text }}</p>
      <p>{{ section.settings.after_text }}</p>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "KS Przed i po",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nad nagłówkiem", "default": "Przed i po" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Ten sam kot, te same zęby, inne ręce" },
    { "type": "image_picker", "id": "before", "label": "Zdjęcie przed" },
    { "type": "text", "id": "before_label", "label": "Etykieta przed", "default": "Przed" },
    { "type": "text", "id": "before_text", "label": "Tekst przed", "default": "Gołe ręce jako zabawka." },
    { "type": "image_picker", "id": "after", "label": "Zdjęcie po" },
    { "type": "text", "id": "after_label", "label": "Etykieta po", "default": "Po" },
    { "type": "text", "id": "after_text", "label": "Tekst po", "default": "Kot gryzie pacynkę, ręka jest w osłonie." }
  ],
  "presets": [{ "name": "KS Przed i po" }]
}
{% endschema %}
