{{ 'ks-landing.css' | asset_url | stylesheet_tag }}
<div class="ks ks-sec ks-sec--alt">
  <div class="ks-wrap" style="max-width:820px">
    <div class="ks-center">
      <span class="ks-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ks-faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <div class="ks-faq__a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "KS FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nad nagłówkiem", "default": "Pytania" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Zanim zamówisz" }
  ],
  "blocks": [
    { "type": "qa", "name": "Pytanie", "settings": [
      { "type": "text", "id": "q", "label": "Pytanie", "default": "Pytanie" },
      { "type": "richtext", "id": "a", "label": "Odpowiedź", "default": "<p>Odpowiedź</p>" }
    ] }
  ],
  "presets": [{ "name": "KS FAQ" }]
}
{% endschema %}
