{{ 'ks-landing.css' | asset_url | stylesheet_tag }}
<div class="ks ks-sec ks-sec--alt">
  <div class="ks-wrap">
    <div class="ks-center">
      <span class="ks-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ks-cards">
      {%- for block in section.blocks -%}
        <div class="ks-card" {{ block.shopify_attributes }}>
          <div class="ks-card__who">{{ block.settings.who }}</div>
          <p class="ks-card__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "KS Czy to dla Ciebie",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nad nagłówkiem", "default": "Czy to dla Ciebie" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Rozpoznajesz się?" }
  ],
  "blocks": [
    { "type": "persona", "name": "Persona", "settings": [
      { "type": "text", "id": "who", "label": "Kto", "default": "Opiekunka kocięcia" },
      { "type": "textarea", "id": "text", "label": "Sytuacja", "default": "Opis sytuacji" }
    ] }
  ],
  "presets": [{ "name": "KS Czy to dla Ciebie" }]
}
{% endschema %}
